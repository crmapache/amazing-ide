{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint:styles)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm check)",
      "Bash(pnpm dist:local)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec stylelint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm --filter @amazing-ide/desktop *)",
      "Bash(node apps/desktop/scripts/cdp.mjs *)",
      "Bash(node scripts/cdp.mjs *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-file.sh\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
